{
  "id": "marketing-studio-image",
  "name": "Marketing Studio Image",
  "endpoint": "marketing-studio/image",
  "category": "image_edit, text2image",
  "summary": "Generates and edits campaign images from text and image inputs, with resolutions from 1K to 4K. Preset mode uses a product photo and an optional model reference to guide the resulting image.",
  "docs": "https://open.higgsfield.ai/models/marketing-studio/image/api-reference",
  "agent_prompt": "https://dash.higgsfield.ai/models/marketing-studio/image/llms.txt",
  "checked": "2026-09-26",
  "pricing_note": "",
  "outputs": [
    "images"
  ],
  "example": {
    "prompt": "A cinematic scene at sunset",
    "quality": "high",
    "moderation": "auto",
    "resolution": "2k",
    "aspect_ratio": "auto",
    "enhance_prompt": false
  },
  "input_schema": {
    "type": "object",
    "allOf": [
      {
        "if": {
          "required": [
            "enhance_prompt"
          ],
          "properties": {
            "enhance_prompt": {
              "const": true
            }
          }
        },
        "then": {
          "required": [
            "preset_id",
            "image_urls"
          ],
          "properties": {
            "quality": {
              "const": "high"
            },
            "image_urls": {
              "maxItems": 2,
              "minItems": 1
            }
          }
        }
      }
    ],
    "title": "Marketing Studio Image",
    "required": [
      "prompt"
    ],
    "properties": {
      "prompt": {
        "type": "string",
        "title": "Prompt",
        "maxLength": 5000,
        "minLength": 1,
        "description": "Write your prompt here"
      },
      "quality": {
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "type": "string",
        "default": "high"
      },
      "preset_id": {
        "type": "string",
        "title": "Preset ID",
        "format": "uuid"
      },
      "image_urls": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uri"
        },
        "title": "Image URLs",
        "maxItems": 16,
        "minItems": 0
      },
      "moderation": {
        "enum": [
          "auto",
          "low"
        ],
        "type": "string",
        "default": "auto"
      },
      "resolution": {
        "enum": [
          "1k",
          "2k",
          "4k"
        ],
        "type": "string",
        "title": "Resolution",
        "default": "2k"
      },
      "aspect_ratio": {
        "enum": [
          "auto",
          "1:1",
          "3:2",
          "2:3",
          "4:3",
          "3:4",
          "16:9",
          "9:16",
          "21:9"
        ],
        "type": "string",
        "title": "Aspect Ratio",
        "default": "auto"
      },
      "enhance_prompt": {
        "type": "boolean",
        "title": "Enhance prompt",
        "default": false
      }
    },
    "additionalProperties": false
  },
  "price_check": "api",
  "sample_usd": "0.439"
}
