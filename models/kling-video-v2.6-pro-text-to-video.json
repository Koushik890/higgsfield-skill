{
  "id": "kling-video-v2.6-pro-text-to-video",
  "name": "Kling 2.6 Pro",
  "endpoint": "kling-video/v2.6/pro/text-to-video",
  "category": "text2video",
  "summary": "Generates videos and sound from text or images, including dialogue, sound effects and ambience.",
  "docs": "https://open.higgsfield.ai/models/kling-video/v2.6/pro/text-to-video/api-reference",
  "agent_prompt": "https://dash.higgsfield.ai/models/kling-video/v2.6/pro/text-to-video/llms.txt",
  "checked": "2026-09-26",
  "pricing_note": "",
  "outputs": [
    "video",
    "zip",
    "mov",
    "jsx",
    "fbx",
    "ply"
  ],
  "example": {
    "sound": "on",
    "prompt": "A cinematic scene at sunset",
    "duration": 5,
    "cfg_scale": 0.5,
    "aspect_ratio": "16:9"
  },
  "input_schema": {
    "type": "object",
    "title": "Kling 2.6 Playground",
    "required": [
      "prompt"
    ],
    "properties": {
      "sound": {
        "enum": [
          "on",
          "off"
        ],
        "type": "string",
        "title": "Generate sound",
        "default": "on"
      },
      "prompt": {
        "type": "string",
        "title": "Prompt",
        "description": "Write your prompt here"
      },
      "duration": {
        "enum": [
          5,
          10
        ],
        "type": "integer",
        "title": "Duration",
        "default": 5
      },
      "cfg_scale": {
        "type": "number",
        "title": "CFG Scale",
        "default": 0.5,
        "maximum": 1,
        "minimum": 0,
        "multipleOf": 0.01
      },
      "aspect_ratio": {
        "enum": [
          "16:9",
          "9:16",
          "1:1"
        ],
        "type": "string",
        "title": "Aspect ratio",
        "default": "16:9"
      }
    }
  },
  "price_check": "api",
  "sample_usd": "0.385"
}
