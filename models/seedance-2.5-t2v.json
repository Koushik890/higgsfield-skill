{
  "id": "seedance-2.5-t2v",
  "name": "Seedance 2.5 (ByteDance) - text to video",
  "endpoint": "bytedance/seedance-2.5/text-to-video",
  "kind": "text-to-video",
  "docs": "https://console.higgsfield.ai/models/bytedance%2Fseedance-2.5%2Ftext-to-video/api-reference",
  "checked": "2026-09-26",
  "notes": "Text only; no image/audio inputs on this endpoint. Output is one video with optional generated audio.",
  "params": {
    "prompt": {"type": "string", "required": true},
    "duration": {"type": "integer", "min": 4, "max": 30, "default": 5},
    "resolution": {"type": "string", "enum": ["480p", "720p"], "default": "720p"},
    "aspect_ratio": {"type": "string", "enum": ["16:9", "4:3", "1:1", "3:4", "9:16", "21:9"], "default": "16:9"},
    "output_format": {"type": "string", "enum": ["mp4", "mov"], "default": "mp4"},
    "generate_audio": {"type": "boolean", "default": true}
  },
  "pricing": {
    "method": "video_tokens",
    "about": "The estimate endpoint returns a pricing description instead of USD for this model. Tokens = ceil(seconds x width x height x 24 / 1024); the per-1,000-token rate is read live from that description.",
    "rate_regex": "each 1,000 video tokens cost \\$([0-9]+(?:\\.[0-9]+)?)",
    "per_tokens": 1000,
    "fps": 24,
    "divisor": 1024,
    "sizes": {
      "480p": {"16:9": [854, 480], "4:3": [640, 480], "1:1": [480, 480], "3:4": [360, 480], "9:16": [270, 480], "21:9": [1006, 480]},
      "720p": {"16:9": [1280, 720], "4:3": [960, 720], "1:1": [720, 720], "3:4": [540, 720], "9:16": [405, 720], "21:9": [1502, 720]}
    }
  }
}
