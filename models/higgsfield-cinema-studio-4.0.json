          "type": "string",
          "format": "uri"
        },
        "maxItems": 30
      },
      "resolution": {
        "enum": [
          "480p",
          "720p"
        ],
        "type": "string",
        "default": "720p"
      },
      "video_urls": {
        "type": "array",
